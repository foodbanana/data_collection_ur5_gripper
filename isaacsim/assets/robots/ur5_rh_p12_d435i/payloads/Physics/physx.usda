#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur5_rh_p12_d435i"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ur5_rh_p12_d435i"
{
    over "Physics"
    {
        over "shoulder_pan_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "shoulder_lift_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "elbow_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist_3_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rh_r1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rh_r2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rh_l1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rh_l2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

