#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "ur5_rh_p12_d435i"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ur5_rh_p12_d435i"
{
    over "Physics"
    {
        over "shoulder_pan_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "shoulder_lift_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "elbow_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_1_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_2_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "wrist_3_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rh_r1_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rh_r2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rh_l1" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rh_l2" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "shoulder_pan_joint_actuator"
        {
            uniform double mjc:forceRange:max = 150
            uniform double mjc:forceRange:min = -150
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/shoulder_pan_joint>
        }

        def MjcActuator "shoulder_lift_joint_actuator"
        {
            uniform double mjc:forceRange:max = 150
            uniform double mjc:forceRange:min = -150
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/shoulder_lift_joint>
        }

        def MjcActuator "elbow_joint_actuator"
        {
            uniform double mjc:forceRange:max = 150
            uniform double mjc:forceRange:min = -150
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/elbow_joint>
        }

        def MjcActuator "wrist_1_joint_actuator"
        {
            uniform double mjc:forceRange:max = 28
            uniform double mjc:forceRange:min = -28
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/wrist_1_joint>
        }

        def MjcActuator "wrist_2_joint_actuator"
        {
            uniform double mjc:forceRange:max = 28
            uniform double mjc:forceRange:min = -28
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/wrist_2_joint>
        }

        def MjcActuator "wrist_3_joint_actuator"
        {
            uniform double mjc:forceRange:max = 28
            uniform double mjc:forceRange:min = -28
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/wrist_3_joint>
        }

        def MjcActuator "rh_r1_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/rh_r1_joint>
        }

        def MjcActuator "rh_r2_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/rh_r2>
        }

        def MjcActuator "rh_l1_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/rh_l1>
        }

        def MjcActuator "rh_l2_actuator"
        {
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            custom rel mjc:target
            append rel mjc:target = </ur5_rh_p12_d435i/Physics/rh_l2>
        }
    }
}

