<?xml version="1.0"?>
<!--
  UR5 (CB3) + sandwich wrist mount + RH-P12-RN(A) + RealSense D435i  (single articulation for Isaac Sim)

  Chain:  robot_mount -> base_link ... wrist_3_link -> flange -> tool0
          tool0 -> wrist_mount (sandwich, thickness = mount_thickness)
          wrist_mount -> rh_p12_rn_base (at z = mount_thickness)
          wrist_mount -> camera_bottom_screw_frame (the 1/4" screw hole on the mount)

  Build with scripts/build_urdf.sh (resolves all mesh paths to absolute paths).

  ### Mount geometry is measured from the STL. Values marked "CHECK"/"MEASURE" must be confirmed on the real hardware. ###
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_rh_p12_d435i">

  <!-- ================= arguments ================= -->
  <xacro:arg name="kinematics_params"
             default="$(find ur_description)/config/ur5/default_kinematics.yaml"/>
  <!-- tip: pass your real calibration for sim/real consistency:
       kinematics_params:=$HOME/my_robot_calibration.yaml -->

  <!-- ===== wrist mount variant (2026-10-15, docs/PLAN.md 5-B "손목 카메라 마운트") =====
       mount_variant selects the mount mesh, collision, mass/inertia AND the camera pose together (they must match):
         t10 (default) : cad/wrist_mount_cad.py, tab moved -32.5 mm in x (RGB lens on the gripper centre line), camera tilted 10 deg
                         toward the tool axis. Printed and checked on the real robot (PLA 15 % infill, 32.36 g).
         t7, t0        : same mount with 7 / 0 deg tilt (CAD only, not printed; mass assumed equal to t10)
         original      : the downloaded mount below, no lateral shift, no tilt
       The camera pose and the mount mass come only from the variant (no separate override, so the camera always matches the mount). -->
  <xacro:arg name="mount_variant" default="t10"/>
  <!-- ===== original wrist mount: "Realsense Support UniversalRobots" (meshes/mount/wrist_mount.stl, mm) =====
       Measured from the STL:
         - 5.0 mm base plate sandwiched between UR flange and gripper (flange face = mesh y=0, gripper face = mesh y=-5)
         - 6.45 mm rim (inner D63.5) wraps around the UR flange (behind the flange face, no offset)
         - 4x D6.5 on PCD50 (ISO 9409-1-50-4-M6), D6.5 pin hole on PCD50, D34 bore
         - camera tab: 2x M3 clearance holes, 45 mm apart (= D435 rear M3 spacing), 57.5 mm from flange axis
       wrist_mount frame = tool0 frame (origin on flange face, +z toward the gripper). Tab points to +y. -->
  <xacro:arg name="mount_thickness" default="0.005"/>   <!-- plate thickness: flange face -> gripper face [m] -->
  <xacro:arg name="mount_yaw" default="0.0"/>           <!-- CHECK vs real: rotation of mount(+camera+gripper) about tool0 z -->
  <!-- RH-P12-RN-UR bracket (FRP42-A120K) between mount and gripper: mount face -> gripper mesh z=0.
       ~10 mm estimated from the RH-P12-RN-UR manual side view (scale from the 54 mm body width):
       flange->wide body 18.8 mm - mesh boss 8.9 mm = 9.9 mm, cross-check flange->fingertip 126.5 - 116.3 = 10.2 mm.
       CHECK with calipers (+-1 mm). -->
  <xacro:arg name="adapter_thickness" default="0.010"/>
  <xacro:arg name="adapter_mass" default="0.08"/>        <!-- MEASURE [kg] -->

  <!-- gripper rotation about wrist_mount z. pi/2: fingers open along the camera's horizontal axis
       (both fingers side by side in the wrist image). 0 would make an open finger touch the camera body. -->
  <xacro:arg name="gripper_yaw" default="1.5708"/>      <!-- verified on the real robot -->

  <!-- camera_bottom_screw_frame pose in wrist_mount frame (+x = viewing direction, +z = camera top).
       Camera back face on the tab (z=0.005), rear M3 holes at (+-0.0225, 0.0575).
       D435 rear M3 holes at half body height (12.5 mm): matches the mount holes within 0.05 mm (verified).
       values below are relative to wrist_camera_mount (hole centre on the tab face):
       default = camera top away from the tool axis (outward, as mounted on the real robot):
                                                          xyz="0 -0.0125 0.01015" rpy="-1.5708 -1.5708 0"
       flipped (camera top toward the tool axis):         xyz="0 0.0125 0.01015"  rpy="1.5708 -1.5708 0" -->
  <!-- wrist_camera_mount frame: centre of the two rear M3 holes on the tab face, tilted about x by cam_tilt.
       cam_tilt > 0 pitches the camera toward the tool axis (for evaluating a tilted mount; 0 = downloaded mount). -->
  <!-- cam_tilt and the screw-frame xyz come from mount_variant (MV below):
       t*: tilt 10 / 7 / 0 deg, xyz "-0.0325 -0.0125 0.01015" (32.5 mm sideways = D435 tripod centre line -> RGB lens, 17.5 + 15, D400 datasheet Fig. 4-7)
       original: tilt 0, xyz "0.0 -0.0125 0.01015" -->
  <xacro:arg name="cam_rpy" default="-1.5708 -1.5708 0.0"/>

  <!-- absolute path of this package (build_urdf.sh passes it automatically) -->
  <xacro:arg name="pkg_dir" default=""/>
  <xacro:property name="pkg_dir" value="$(arg pkg_dir)"/>
  <xacro:property name="t_mount" value="$(arg mount_thickness)"/>
  <!-- per-variant values. COM [m] and per-kg inertia [kg m^2 / kg] about the COM in the wrist_mount frame, from the STL (uniform density) -->
  <xacro:property name="MV" value="${dict(
      original=dict(mesh='wrist_mount.stl', rpy='-1.5708 0 0', mass=0.05, tilt=0.0, cam_xyz='0.0 -0.0125 0.01015',
                    com='-0.0019 0.0224 0.0001', I=(8.910e-04, 6.40e-05, 3.1e-06, 4.615e-04, 1.22e-05, 1.3319e-03)),
      t0=dict(mesh='wrist_mount_t0.stl', rpy='0 0 0', mass=0.03236, tilt=0.0, cam_xyz='-0.0325 -0.0125 0.01015',
              com='-0.02677 0.02534 -0.00022', I=(7.2038e-04, 3.788e-04, -1.316e-05, 9.6429e-04, 1.199e-05, 1.6629e-03)),
      t7=dict(mesh='wrist_mount_t7.stl', rpy='0 0 0', mass=0.03236, tilt=radians(7), cam_xyz='-0.0325 -0.0125 0.01015',
              com='-0.02665 0.02504 -0.00029', I=(7.2460e-04, 3.821e-04, -1.388e-05, 9.6710e-04, 1.345e-05, 1.6702e-03)),
      t10=dict(mesh='wrist_mount_t10.stl', rpy='0 0 0', mass=0.03236, tilt=radians(10), cam_xyz='-0.0325 -0.0125 0.01015',
               com='-0.0266 0.0249 -0.00031', I=(7.2645e-04, 3.836e-04, -1.414e-05, 9.6841e-04, 1.395e-05, 1.6733e-03)))}"/>
  <xacro:property name="mv" value="$(arg mount_variant)"/>
  <xacro:unless value="${mv in MV}">${xacro.fatal('mount_variant must be one of ' + str(sorted(MV)) + ': ' + mv)}</xacro:unless>
  <xacro:property name="M" value="${MV[mv]}"/>
  <xacro:property name="m_mount" value="${M['mass']}"/>     <!-- original: estimate (45.1 cm^3); t*: printed t10 weighed 32.36 g (PLA, 15 % infill) -->
  <xacro:property name="cam_tilt" value="${M['tilt']}"/>
  <xacro:property name="cam_xyz" value="${M['cam_xyz']}"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>
  <xacro:include filename="rh_p12_rn_a.urdf.xacro"/>

  <!-- ================= root: mounting plate =================
       This is the link you fix (FixedJoint) to the table now, and to the 6-DOF base later.
       No "world" link on purpose, so the importer does not weld the robot to the world origin. -->
  <link name="robot_mount">
    <inertial>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1.7e-3" ixy="0" ixz="0" iyy="1.7e-3" iyz="0" izz="3.3e-3"/>
    </inertial>
  </link>

  <!-- ================= UR5 (CB3) ================= -->
  <xacro:ur_robot
    name="ur5"
    tf_prefix=""
    parent="robot_mount"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ================= sandwich wrist mount ================= -->
  <joint name="wrist_mount_joint" type="fixed">
    <parent link="tool0"/>
    <child link="wrist_mount"/>
    <origin xyz="0 0 0" rpy="0 0 $(arg mount_yaw)"/>
  </joint>

  <link name="wrist_mount">
    <visual>
      <!-- original mesh frame -> wrist_mount: Rx(-90deg) (mesh -y -> +z, mesh +z -> +y). t* meshes are already in the wrist_mount frame -->
      <origin xyz="0 0 0" rpy="${M['rpy']}"/>
      <geometry><mesh filename="${pkg_dir}/meshes/mount/${M['mesh']}" scale="0.001 0.001 0.001"/></geometry>
      <material name="mount_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <!-- simple collision, only on the gripper side of the flange face (z >= 0) except the tab beyond the flange:
         a convex hull of the whole mesh would fill the flange pocket and the bore and overlap the wrist -->
    <xacro:if value="${mv == 'original'}">
      <collision>
        <origin xyz="0 0 ${t_mount/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0375" length="${t_mount}"/></geometry>
      </collision>
      <collision>
        <origin xyz="-0.015 0.0544 -0.0007" rpy="0 0 0"/>
        <geometry><box size="0.085 0.018 0.0114"/></geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="${mv == 'original'}">
      <!-- plate: the mount outline (disk + diagonal wing + tab), z 0 ~ 5 mm (cad/out/wrist_mount_collision_plate.stl, convex) -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${pkg_dir}/meshes/mount/wrist_mount_collision_plate.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <!-- camera tab, full thickness (z -6.45 ~ 5 mm), x -89.8 ~ -5.0, y 50.4 ~ 63.4 mm (tilted top up to +1 mm ignored) -->
      <collision>
        <origin xyz="-0.0474 0.0569 -0.000725" rpy="0 0 0"/>
        <geometry><box size="0.0848 0.013 0.01145"/></geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <!-- COM and per-kg inertia computed from the STL (uniform density) -->
      <origin xyz="${M['com']}" rpy="0 0 0"/>
      <mass value="${m_mount}"/>
      <inertia ixx="${m_mount*M['I'][0]}" ixy="${m_mount*M['I'][1]}" ixz="${m_mount*M['I'][2]}"
               iyy="${m_mount*M['I'][3]}" iyz="${m_mount*M['I'][4]}" izz="${m_mount*M['I'][5]}"/>
    </inertial>
  </link>

  <!-- ================= RH-P12-RN-UR bracket (simple shapes) ================= -->
  <xacro:property name="t_adp" value="$(arg adapter_thickness)"/>
  <xacro:property name="m_adp" value="$(arg adapter_mass)"/>
  <joint name="gripper_bracket_joint" type="fixed">
    <parent link="wrist_mount"/>
    <child link="gripper_bracket"/>
    <origin xyz="0 0 ${t_mount}" rpy="0 0 $(arg gripper_yaw)"/>
  </joint>
  <link name="gripper_bracket">
    <!-- round plate D63 x 4 mm on the mount, then a 42 x 42 square frame up to the gripper -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0315" length="0.004"/></geometry>
      <material name="bracket_black"><color rgba="0.08 0.08 0.08 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 ${0.004 + (t_adp-0.004)/2}" rpy="0 0 0"/>
      <geometry><box size="0.042 0.042 ${t_adp-0.004}"/></geometry>
      <material name="bracket_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0315" length="0.004"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${0.004 + (t_adp-0.004)/2}" rpy="0 0 0"/>
      <geometry><box size="0.042 0.042 ${t_adp-0.004}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${t_adp/2}" rpy="0 0 0"/>
      <mass value="${m_adp}"/>
      <inertia ixx="${m_adp*(3*0.0315**2 + t_adp**2)/12}" ixy="0" ixz="0"
               iyy="${m_adp*(3*0.0315**2 + t_adp**2)/12}" iyz="0" izz="${m_adp*0.0315**2/2}"/>
    </inertial>
  </link>

  <!-- ================= gripper ================= -->
  <xacro:rh_p12_rn_a prefix="" parent="gripper_bracket" mesh_dir="${pkg_dir}/meshes/rh_p12_rn_a">
    <origin xyz="0 0 ${t_adp}" rpy="0 0 0"/>
  </xacro:rh_p12_rn_a>

  <!-- ================= wrist camera (D435i) =================
       use_nominal_extrinsics=true -> creates camera_color_frame / camera_color_optical_frame
       (in the real robot the driver publishes these; in sim we need them in the model). -->
  <joint name="wrist_camera_mount_joint" type="fixed">
    <parent link="wrist_mount"/>
    <child link="wrist_camera_mount"/>
    <origin xyz="0 0.0575 ${t_mount}" rpy="${cam_tilt} 0 0"/>
  </joint>
  <link name="wrist_camera_mount"/>

  <xacro:sensor_d435i parent="wrist_camera_mount" name="wrist_camera" use_nominal_extrinsics="true" add_plug="false" use_mesh="true">
    <origin xyz="${cam_xyz}" rpy="$(arg cam_rpy)"/>
  </xacro:sensor_d435i>

</robot>
