<?xml version="1.0"?>
<!--
  RH-P12-RN(A) gripper macro.

  Source: ROBOTIS-GIT/open_manipulator (main), open_manipulator_description/urdf/omy_f3m/rh_p12_rn_a.urdf.xacro
          (Apache-2.0, meshes copied to ../meshes/rh_p12_rn_a/)

  Changes from the original:
    - mesh path is a macro parameter (no package:// dependency)
    - inertia tensors recomputed from the STL meshes (uniform density, same masses as original).
      The original used 1e-6 placeholders, which makes PhysX unstable.
    - added a "tcp" frame between the finger pads (not in the original)

  Frame convention of ${prefix}rh_p12_rn_base:
    +z : toward the fingertips (mount face at z=0)
    +-y: finger opening direction
    rh_r1_joint: 0.0 (open) ~ 1.1351 rad (closed). Real raw 0~1150 maps linearly to this range.
    rh_r2 / rh_l1 / rh_l2 mimic rh_r1_joint with multiplier 1 (parallel fingers; the real
    passive adaptive joints are NOT modelled).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rh_p12_rn_a" params="prefix parent mesh_dir *origin">

    <joint name="${prefix}rh_p12_rn_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}rh_p12_rn_base"/>
    </joint>

    <!-- base -->
    <link name="${prefix}rh_p12_rn_base">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/base.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="rh_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/base.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0 0.0319" rpy="0 0 0"/>
        <mass value="0.236"/>
        <inertia ixx="1.669e-04" ixy="0.0" ixz="0.0" iyy="1.104e-04" iyz="0.0" izz="1.682e-04"/>
      </inertial>
    </link>

    <!-- right finger, proximal (actuated) -->
    <joint name="${prefix}rh_r1_joint" type="revolute">
      <parent link="${prefix}rh_p12_rn_base"/>
      <child link="${prefix}rh_p12_rn_r1"/>
      <origin xyz="0.0 0.008 0.048" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="6.5" effort="1000" lower="0.0" upper="1.13514578304"/>
      <dynamics damping="0.7"/>
    </joint>

    <link name="${prefix}rh_p12_rn_r1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/r1.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="rh_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/r1.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0343 0.0042" rpy="0 0 0"/>
        <mass value="0.068"/>
        <inertia ixx="3.631e-05" ixy="0.0" ixz="0.0" iyy="2.003e-05" iyz="-6.658e-06" izz="2.394e-05"/>
      </inertial>
    </link>

    <!-- right finger, distal (mimic) -->
    <joint name="${prefix}rh_r2" type="revolute">
      <parent link="${prefix}rh_p12_rn_r1"/>
      <child link="${prefix}rh_p12_rn_r2"/>
      <origin xyz="0.0 0.0493634 0.0285" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit velocity="6.5" effort="1000" lower="0.0" upper="1.13514578304"/>
      <dynamics damping="0.7"/>
      <mimic joint="${prefix}rh_r1_joint" multiplier="1"/>
    </joint>

    <link name="${prefix}rh_p12_rn_r2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/r2.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="rh_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/r2.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 0.0064 0.0112" rpy="0 0 0"/>
        <mass value="0.022"/>
        <inertia ixx="4.914e-06" ixy="0.0" ixz="0.0" iyy="5.497e-06" iyz="8.339e-07" izz="1.896e-06"/>
      </inertial>
    </link>

    <!-- left finger, proximal (mimic) -->
    <joint name="${prefix}rh_l1" type="revolute">
      <parent link="${prefix}rh_p12_rn_base"/>
      <child link="${prefix}rh_p12_rn_l1"/>
      <origin xyz="0.0 -0.008 0.048" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit velocity="6.5" effort="1000" lower="0.0" upper="1.13514578304"/>
      <dynamics damping="0.7"/>
      <mimic joint="${prefix}rh_r1_joint" multiplier="1"/>
    </joint>

    <link name="${prefix}rh_p12_rn_l1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/l1.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="rh_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/l1.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 -0.0343 0.0042" rpy="0 0 0"/>
        <mass value="0.068"/>
        <inertia ixx="3.631e-05" ixy="0.0" ixz="0.0" iyy="2.003e-05" iyz="6.658e-06" izz="2.394e-05"/>
      </inertial>
    </link>

    <!-- left finger, distal (mimic) -->
    <joint name="${prefix}rh_l2" type="revolute">
      <parent link="${prefix}rh_p12_rn_l1"/>
      <child link="${prefix}rh_p12_rn_l2"/>
      <origin xyz="0.0 -0.0493634 0.0285" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit velocity="6.5" effort="1000" lower="0.0" upper="1.13514578304"/>
      <dynamics damping="0.7"/>
      <mimic joint="${prefix}rh_r1_joint" multiplier="1"/>
    </joint>

    <link name="${prefix}rh_p12_rn_l2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/l2.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="rh_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/l2.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 -0.0064 0.0112" rpy="0 0 0"/>
        <mass value="0.022"/>
        <inertia ixx="4.914e-06" ixy="0.0" ixz="0.0" iyy="5.497e-06" iyz="-8.339e-07" izz="1.896e-06"/>
      </inertial>
    </link>

    <!-- TCP: between the finger pads. Fingertips sit at z~0.117 (open) ~ 0.145 (closed),
         pad centre moves roughly z 0.09 ~ 0.12. 0.11 is a middle value; adjust if needed. -->
    <joint name="${prefix}rh_p12_rn_tcp_joint" type="fixed">
      <parent link="${prefix}rh_p12_rn_base"/>
      <child link="${prefix}rh_p12_rn_tcp"/>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}rh_p12_rn_tcp"/>

  </xacro:macro>
</robot>
